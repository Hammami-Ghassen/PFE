# Copy this file to ETL/.env and adapt values to your environment.

# Source PostgreSQL: grh_msp
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=grh_msp
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres
SOURCE_DB_SCHEMA=public

# Data warehouse PostgreSQL: DW_msp
DW_DB_HOST=localhost
DW_DB_PORT=5432
DW_DB_NAME=DW_msp
DW_DB_USER=postgres
DW_DB_PASSWORD=postgres

# ETL behavior
ETL_PIPELINE_NAME=phase1_etl_grh_msp
ETL_CHUNK_SIZE=100000
ETL_FULL_HISTORY_LOAD=true
ETL_AUTO_PREPARE_SCHEMA=true

# Airflow runtime (Docker bootstrap)
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW_WEBSERVER_PORT=8080

# Airflow admin user (created at container startup)
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_WWW_USER_FIRSTNAME=ETL
AIRFLOW_WWW_USER_LASTNAME=Admin
AIRFLOW_WWW_USER_EMAIL=etl-admin@local
